PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/byrgop
CLIENT_ORIGINS=http://localhost:5175,http://localhost:5174
QUESTION_TIMEOUT_SECONDS=30

# Atlas migration (scripts/migrateAtlas.js): source is the local DB, target is Atlas.
# Only static config collections are migrated — NEVER user/personal/session data.
MIGRATE_SOURCE_URI=mongodb://127.0.0.1:27017/byrgop
MIGRATE_TARGET_URI=mongodb+srv://<atlas-user>@<cluster>.mongodb.net/byrgop

# Admin authentication
ADMIN_JWT_SECRET=change-me-to-a-long-random-secret
ADMIN_JWT_EXPIRES=8h
ADMIN_BCRYPT_ROUNDS=12

# Initial Super Admin bootstrap (one-time; remove after first run)
SUPER_ADMIN_EMAIL=admin@byrgop.local
SUPER_ADMIN_PASSWORD=ChangeMe!12345